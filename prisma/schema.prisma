generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Regiao {
  NORTE
  NORDESTE
  CENTRO_OESTE
  SUDESTE
  SUL
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  usuario   String   @unique
  senha     String
  regioes   Regiao[]
  listas    Lista[]
  ofertas   Oferta[]
  createdAt DateTime @default(now())
}

model Lista {
  id        String      @id @default(cuid())
  nome      String
  isPadrao  Boolean     @default(false)
  usuarioId String?
  usuario   Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens     ItemLista[]
  createdAt DateTime    @default(now())
}

model ItemLista {
  id         String  @id @default(cuid())
  listaId    String
  lista      Lista   @relation(fields: [listaId], references: [id], onDelete: Cascade)
  nome       String
  quantidade Int     @default(1)
  comprado   Boolean @default(false)
}

model Oferta {
  id        String   @id @default(cuid())
  mercado   String
  regiao    Regiao
  validade  DateTime?
  produto   String
  preco     Float
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
}